# 비워두면 로컬 모드(인증 없이 /app 동작). 채우면 SaaS 클라우드 모드.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Clerk 경로 (path routing — hash SSO 무한로딩·클라이언트 예외 방지)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 쉼표 구분. 기본 슈퍼관리자: sarangred777@gmail.com (코드 내장)
SUPER_ADMIN_EMAILS=sarangred777@gmail.com
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=sarangred777@gmail.com

# all-36: 독립 관리자 로그인(RDOS 이식) — Clerk 로그인/설정과 무관하게
# /api/admin/login 에서 이 아이디·비밀번호로 서명된 관리자 세션 쿠키를 발급받는다.
# 셋 중 하나라도 비우면 로컬 관리자 로그인이 비활성화된다(하드코딩 폴백 없음).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 세션 서명 + 서버-투-서버 x-admin-secret 헤더/?secret= 검증에 쓰는 긴 무작위 문자열
ADMIN_API_SECRET=generate-a-long-random-string

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Microsoft Clarity (기본값: xlpzvkjzsd — 비우려면 빈 문자열)
